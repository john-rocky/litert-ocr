{
  "name": "litert-ocr",
  "version": "0.1.0",
  "description": "OCR in the browser and Node.js with the tesseract.js API: PP-OCRv6-Small on LiteRT.js (WebGPU or WebAssembly), images never leave the device. PDFs, scans and photos to Markdown with tables, JSON or text; a CLI and an MCP server.",
  "keywords": [
    "ocr",
    "tesseract",
    "tesseract.js",
    "text-recognition",
    "pdf-to-markdown",
    "markdown",
    "pdf",
    "paddleocr",
    "pp-ocr",
    "litert",
    "webgpu",
    "webassembly",
    "offline",
    "mcp"
  ],
  "license": "Apache-2.0",
  "author": "john-rocky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-rocky/litert-ocr.git"
  },
  "homepage": "https://github.com/john-rocky/litert-ocr#readme",
  "bugs": {
    "url": "https://github.com/john-rocky/litert-ocr/issues"
  },
  "type": "module",
  "main": "./dist/node.js",
  "browser": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    },
    "./extract": {
      "types": "./dist/types/extract/browser.d.ts",
      "browser": "./dist/extract.js",
      "node": "./dist/extract-node.js",
      "default": "./dist/extract.js"
    },
    "./worker.js": "./dist/worker.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "litert-ocr": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run.mjs",
    "test:node": "node test/run.mjs node",
    "test:browser": "node test/run.mjs browser"
  },
  "dependencies": {
    "@litertjs/core": "2.5.3",
    "jpeg-js": "0.4.4",
    "pdfjs-dist": "6.4.299",
    "pngjs": "7.0.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "1.0.11",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@litert-lm/core": "0.19.0-nightly.20261018"
  },
  "peerDependenciesMeta": {
    "@litert-lm/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@litert-lm/core": "0.19.0-nightly.20261018",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  }
}
